# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 数据存储：默认 SQLite；生产改为 MySQL 8.0+
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/customer_service?charset=utf8mb4
DATABASE_URL=sqlite:///./data/customer_service.db

# 阿里云 OSS（留空则落本地 data/oss）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_PREFIX=customer-service/

# 向量检索：默认 BGE-small-zh-v1.5（512 维）。换模型或维度后必须 python main.py ingest
FAISS_INDEX_PATH=data/faiss_index
EMBEDDING_BACKEND=huggingface
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
# EMBEDDING_BACKEND=ngram
# RAG_MIN_SCORE=0.2
# 向量相似度低于此值且 BM25 未命中则空召回；0 表示关闭
# RAG_HYBRID_ENABLED=true
# RAG_RRF_K=60
# RAG_NEIGHBOR_CHUNKS=1
# 命中后补同 section 与前后各 N 个切片，不把整份源文件倒进上下文
# RAG_CONTEXT_TOKEN_BUDGET=4096
# 扩展后检索上下文 token 预算；0 关闭裁剪
# RAG_RERANK_ENABLED=false
# RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RAG_RERANK_FETCH_K=24
# RAG_RERANK_TOP_K=6
# RAG_RERANK_TIMEOUT_SECONDS=3.0
# RAG_DYNAMIC_K_ENABLED=true
# RAG_FETCH_K_MIN=12
# RAG_FETCH_K_MAX=32
# RAG_REWRITE_ENABLED=true
# RAG_LLM_REWRITE_ENABLED=false
# RAG_LLM_REWRITE_MAX_QUERIES=3
# 生产环境可按基准测试开启精排：RAG_RERANK_ENABLED=true
# RAG_EVAL_HARVEST_ENABLED=true
# RAG_EVAL_HARVEST_DIR=evals/pending
# RAG_EVAL_SNAPSHOT_TTL_SECONDS=3600

# 服务
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# json | text；生产建议 json，本地可读可改 text
LOG_FORMAT=json
# 多租户：缺省 X-Tenant-Id
DEFAULT_TENANT=demo
# 管理面知识库 ingest；留空则禁用 POST /admin/knowledge/ingest
# ADMIN_INGEST_TOKEN=

# 并发：请求层 asyncio 限流；图与工具仍走线程池
CHAT_CONCURRENCY=8
GRAPH_WORKERS=8
ORDER_TOOL_WORKERS=4
# 订单工具超时（秒）；超时记 cs_tool_calls_total{outcome=timeout}；0=不限制
ORDER_TOOL_TIMEOUT_SECONDS=10
# 单轮 LLM 调用超过该次数记 cs_agent_runaway_total{reason=high_llm_calls}；0=关闭
AGENT_RUNAWAY_LLM_CALLS=8
# 工具失败降级：瞬态错误读会话/Redis 缓存；累计失败或 ReACT 撞限可自动转人工
# TOOL_CACHE_ENABLED=true
# TOOL_CACHE_ORDER_TTL_SECONDS=600
# TOOL_CACHE_COURSE_TTL_SECONDS=1800
# TOOL_ESCALATION_ENABLED=true
# TOOL_ESCALATION_TRANSIENT_THRESHOLD=2
# TOOL_ESCALATION_ON_REACT_LIMIT=true
UVICORN_WORKERS=1
# workers>1 时 /metrics 自动聚合；也可显式指定共享目录
# PROMETHEUS_MULTIPROC_DIR=
# 仅 MySQL
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# 会话历史按 token 裁剪（优先按模型解析 tokenizer；失败回退 cl100k + 校准系数）
HISTORY_TOKEN_BUDGET=8000
HISTORY_MIN_MESSAGES=10
# HISTORY_TOKENIZER_NAME=cl100k_base
# HISTORY_TOKEN_ESTIMATE_RATIO=1.0

# 分级压缩与摘要（默认 LLM；失败 / 纯闲聊回退规则）
# CONTEXT_ALWAYS_KEEP_RECENT=10
CONTEXT_SUMMARY_USE_LLM=true
SESSION_SUMMARY_MAX_CHARS=800

# 用户长期记忆（LangGraph Store）；anonymous 不落盘
USER_MEMORY_ENABLED=true
USER_MEMORY_TTL_MINUTES=43200

# 短期会话 / 长期档案 / LLM 配额。单进程演示可留空；多 worker 或生产必须配置
# 已填写时启动会 ping，连不上拒绝启动，不会回退内存
# REDIS_URL=redis://127.0.0.1:6379/0
SESSION_TTL_SECONDS=604800
# 同一会话互斥锁（覆盖整轮对话）；冲突等待后返回 HTTP 409
SESSION_LOCK_TTL_SECONDS=180
SESSION_LOCK_WAIT_SECONDS=10
SESSION_LOCK_RETRY_INTERVAL_SECONDS=0.05

# LLM Gateway：超时、重试、熔断、租户日 token 限额、短响应缓存
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# LLM_CIRCUIT_FAILURE_THRESHOLD=3
# LLM_CIRCUIT_COOLDOWN_SECONDS=30
# LLM_DAILY_TOKEN_LIMIT=500000
# 百万 token 单价（元），用于 /metrics 的 cs_llm_cost_yuan_total
# LLM_PROMPT_PRICE_PER_MTOK_YUAN=1.0
# LLM_COMPLETION_PRICE_PER_MTOK_YUAN=2.0
# LLM_CACHE_ENABLED=true
# LLM_CACHE_TTL_SECONDS=300
# LLM_CACHE_MAX_CHARS=4000
# LLM_CACHE_ALLOW_REACT=false

# Langfuse（自建轨迹；两把钥匙都配齐才上报；不配则零开销）
# 先起独立栈：cp langfuse.env.example langfuse.env
# docker compose -f docker-compose.langfuse.yml -p cs-langfuse --env-file langfuse.env up -d
# 打开 http://127.0.0.1:3000 ，或使用 langfuse.env 里 INIT 生成的演示密钥
# LANGFUSE_PUBLIC_KEY=pk-lf-local-demo
# LANGFUSE_SECRET_KEY=sk-lf-local-demo
# LANGFUSE_HOST=http://127.0.0.1:3000

# OpenTelemetry（HTTP/DB/Redis/httpx 链路；OTLP 默认打到 Langfuse）
# 配齐 Langfuse 密钥后自动开启；也可用 OTEL_EXPORTER_OTLP_ENDPOINT 直连自定义 Collector
# OTEL_ENABLED=true
# OTEL_SERVICE_NAME=customer-service
# OTEL_ENVIRONMENT=development
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
