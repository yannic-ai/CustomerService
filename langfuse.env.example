# 复制为 langfuse.env 后启动：
#   docker compose -f docker-compose.langfuse.yml -p cs-langfuse --env-file langfuse.env up -d
# UI: http://127.0.0.1:3000 （首次注册账号即管理员）
# 在项目设置里创建 API Key，再写入应用 .env 的 LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY

NEXTAUTH_URL=http://localhost:3000
# CHANGEME: openssl rand -base64 32
NEXTAUTH_SECRET=cs-langfuse-nextauth-change-me
# CHANGEME
SALT=cs-langfuse-salt-change-me
# CHANGEME: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
# 容器内 Postgres；勿与应用 DATABASE_URL 混淆
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse

REDIS_AUTH=cs-langfuse-redis-change-me

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret

# 可选：启动时自动创建组织/项目与密钥（便于本地演示）
LANGFUSE_INIT_ORG_ID=cs-demo-org
LANGFUSE_INIT_ORG_NAME=CustomerService
LANGFUSE_INIT_PROJECT_ID=cs-demo
LANGFUSE_INIT_PROJECT_NAME=customer-service
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local-demo
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local-demo
LANGFUSE_INIT_USER_EMAIL=admin@localhost.local
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=adminchangeme
